{
  "name": "@mcpaql/example-electoral-vote-map",
  "version": "0.2.0",
  "private": true,
  "description": "Native MCP-AQL demo for discovering and exploring Electoral Vote Map scenarios",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "node src/server.js",
    "start:http": "node src/server.js --transport=http",
    "start:https": "node src/server.js --transport=https",
    "build:worker": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .worker-build",
    "test:worker": "npm run build:worker && node --test --test-concurrency=1 test/workers/*.test.js",
    "test": "node --test test/*.test.js",
    "smoke:live": "node scripts/live-smoke.js",
    "smoke:polling": "node scripts/polling-live-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "miniflare": "5.20261113.0-beta",
    "wrangler": "4.162.0"
  }
}
